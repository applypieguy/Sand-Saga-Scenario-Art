const BrushDefs = window.SandGameJS.BrushDefs;
const Brushes = window.SandGameJS.Brushes;
const ToolDefs = window.SandGameJS.ToolDefs;
const Tools = window.SandGameJS.Tools;
const Scenes = window.SandGameJS.Scenes;

// --- Specialized Art Palettes ---
const neonMagenta = Brushes.color(255, 0, 127, BrushDefs.SAND);
const neonCyan = Brushes.color(0, 240, 255, BrushDefs.WATER);
const neonGold = Brushes.color(255, 215, 0, BrushDefs.WALL); // Using Wall so gold color is locked
const emeraldFlora = Brushes.color(0, 200, 115, ToolDefs.PLANT ? BrushDefs.PLANT : BrushDefs.WALL);
const deepViolet = Brushes.color(138, 43, 226, BrushDefs.SAND);

// --- Cosmic Burst & Explosion Brushes ---
const cosmicSparkle = Brushes.color(255, 255, 220, BrushDefs.SAND); // Replaced fire base to preserve pale yellow tint
const supernovaEmbers = Brushes.color(255, 90, 0, BrushDefs.SAND);  // Replaced fire base to preserve blazing orange tint

// --- Sand Saga Native Structural Art Tools ---
const rainbowStreamerTool = Tools.roundBrushTool(neonMagenta, ToolDefs.DEFAULT_SIZE, ToolDefs.SAND.getInfo().derive({
    badgeStyle: { backgroundColor: 'rgb(255, 0, 127)' }
}));

const watercolorBleedTool = Tools.roundBrushTool(neonCyan, ToolDefs.DEFAULT_SIZE, ToolDefs.WATER.getInfo().derive({
    badgeStyle: { backgroundColor: 'rgb(0, 240, 255)' }
}));

const fireArtTool = Tools.roundBrushTool(neonGold, ToolDefs.DEFAULT_SIZE, ToolDefs.WALL.getInfo().derive({
    badgeStyle: { backgroundColor: 'rgb(255, 215, 0)' }
}));

const plantBaseInfo = ToolDefs.PLANT ? ToolDefs.PLANT.getInfo() : ToolDefs.WALL.getInfo();
const botanicalArtTool = Tools.roundBrushTool(emeraldFlora, ToolDefs.DEFAULT_SIZE, plantBaseInfo.derive({
    badgeStyle: { backgroundColor: 'rgb(0, 200, 115)' }
}));

const heavyCanvasTool = Tools.roundBrushTool(deepViolet, ToolDefs.DEFAULT_SIZE, ToolDefs.WALL.getInfo().derive({
    badgeStyle: { backgroundColor: 'rgb(138, 43, 226)' }
}));

// --- Exploding Sparkle Tools ---
const cosmicSparklerTool = Tools.roundBrushTool(cosmicSparkle, ToolDefs.DEFAULT_SIZE, ToolDefs.SAND.getInfo().derive({
    badgeStyle: { backgroundColor: 'rgb(255, 255, 220)' }
}));

const supernovaTool = Tools.roundBrushTool(supernovaEmbers, ToolDefs.DEFAULT_SIZE, ToolDefs.SAND.getInfo().derive({
    badgeStyle: { backgroundColor: 'rgb(255, 90, 0)' }
}));

// --- Full Sandbox Configuration Setup ---
return {
    scene: {
        init: function(sandGame) {
            // Generates only a clean, decorative base pedestal line for painting surfaces
            const frameColorA = Brushes.color(80, 50, 30, BrushDefs.WALL);
            const frameColorB = Brushes.color(120, 80, 50, BrushDefs.WALL);
            
            sandGame.graphics().drawRectangle(20, 160, 360, 10, frameColorA);
            sandGame.graphics().drawRectangle(40, 170, 320, 5, frameColorB);
        }
    },
    tools: [
        ToolDefs.ERASE,
        ToolDefs.MOVE,
        ToolDefs.WALL,
        ToolDefs.FIRE,
        ToolDefs.ACID,
        ToolDefs.WATER,
        rainbowStreamerTool,   // Custom Magenta Sand Painter
        watercolorBleedTool,   // Custom Fluid Cyan Mixer
        fireArtTool,           // Custom Gold Wall Spreader (Now color-locked)
        botanicalArtTool,      // Custom Emerald Plant Structure
        heavyCanvasTool,       // Custom Violet Solid Backdrop
        cosmicSparklerTool,    // Bright Sparkle Flares (Now color-locked)
        supernovaTool          // Explosive Art Stardust Drops (Now color-locked)
    ],
    disableSizeChange: false, 
    disableSettings: true,
    disableSceneSelection: true
};
